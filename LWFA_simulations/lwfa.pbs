#!/bin/bash
#PBS -N cluster_lwfa
#PBS -l select=1:ncpus=128:mpiprocs=64:ompthreads=2:mem=128gb
#PBS -l walltime=24:00:00
#PBS -o baseline.out
#PBS -e baseline.err

cd $PBS_O_WORKDIR


module purge
module load tools/prod
module load foss/2022a
module load Python/3.10.4-GCCcore-11.3.0
module load HDF5/1.12.2-gompi-2022a

export OMP_NUM_THREADS=2

mpirun -np 64 ./smilei lwfa.py > baseline.log 2>&1
